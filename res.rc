#include "inc/version.h"
#include "inc/git.h"


1 VERSIONINFO
FILEVERSION VERSION
PRODUCTVERSION VERSION
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904B0"
        {
            VALUE "CompanyName", "github.com/vvekic/DirectCRT"
            VALUE "FileDescription", "DirectCRT - DirectDraw with CRT shading"
            VALUE "FileVersion", VERSION_STRING " (git~" GIT_COMMIT ", " GIT_BRANCH ")"
            VALUE "InternalName", "ddraw"
            VALUE "LegalCopyright", "GPL-2.0-or-later. Based on cnc-ddraw, Copyright (c) 2010-2025 FunkyFr3sh"
            VALUE "LegalTrademarks", ""
            VALUE "OriginalFileName", "ddraw.dll"
            VALUE "ProductName", "DirectCRT"
            VALUE "ProductVersion", VERSION_STRING " (git~" GIT_COMMIT ", " GIT_BRANCH ")"
            VALUE "Comments", "https://github.com/vvekic/DirectCRT"
        }
    }

    BLOCK "VarFileInfo"
    {
        VALUE "Translation",  0x0409, 0x04B0
    }
}
