#include "inc/version.h"
#include "inc/git.h"


1 VERSIONINFO
FILEVERSION VERSION
PRODUCTVERSION VERSION
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904B0"
        {
            VALUE "CompanyName", "github.com/vvekic/DirectCRT"
            VALUE "FileDescription", "DirectCRT - DirectDraw with CRT shading"
            VALUE "FileVersion", VERSION_STRING " (git~" GIT_COMMIT ", " GIT_BRANCH ")"
            VALUE "InternalName", "ddraw"
            VALUE "LegalCopyright", "GPL-2.0-or-later. Based on cnc-ddraw, Copyright (c) 2010-2025 FunkyFr3sh"
            VALUE "LegalTrademarks", ""
            VALUE "OriginalFileName", "ddraw.dll"
            VALUE "ProductName", "DirectCRT"
            VALUE "ProductVersion", VERSION_STRING " (git~" GIT_COMMIT ", " GIT_BRANCH ")"
            VALUE "Comments", "https://github.com/vvekic/DirectCRT"
        }
    }

    BLOCK "VarFileInfo"
    {
        VALUE "Translation",  0x0409, 0x04B0
    }
}

/* crt-auto: DOSBox Staging's shaders and presets, loaded by src/render_ogl.c */
CRT_IMAGE_ADJUSTMENTS          RCDATA "third_party/dosbox-staging/resources/shaders/_internal/image-adjustments.glsl"
CRT_HYLLIAN                    RCDATA "third_party/dosbox-staging/resources/shaders/crt/crt-hyllian.glsl"
CRT_VGA_1080P                  RCDATA "third_party/dosbox-staging/resources/shaders/crt/vga-1080p.glsl"
CRT_VGA_1080P_FAKE_DOUBLE_SCAN RCDATA "third_party/dosbox-staging/resources/shaders/crt/vga-1080p-fake-double-scan.glsl"
CRT_SHARP                      RCDATA "third_party/dosbox-staging/resources/shaders/interpolation/sharp.glsl"
CRT_PRESET_VGA_1440P           RCDATA "third_party/dosbox-staging/resources/shader-presets/crt/crt-hyllian/vga-1440p.preset"
CRT_PRESET_VGA_4K              RCDATA "third_party/dosbox-staging/resources/shader-presets/crt/crt-hyllian/vga-4k.preset"
